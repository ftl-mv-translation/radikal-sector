#: src-en/data/events.xml.append:2737
msgid ""
"data/events.xml.append$//event[@name=\"RK_GEAR_BUYER_ZOLTAN\"]/choice[2]/event/text"
msgstr ""
"Vous les laissez à leurs ennuis, et pensez plutôt à faire un peu d'entretien"
" sur votre vaisseau."

#: src-en/data/events.xml.append:2739
msgid ""
"data/events.xml.append$//event[@name=\"RK_GEAR_BUYER_ZOLTAN\"]/choice[2]/event/choice[1]/text"
